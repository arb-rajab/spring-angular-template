# Copy this file to .env and adjust values for local docker-compose runs.
# .env is gitignored - never commit real secrets.

DB_NAME=project_name
DB_USERNAME=project_name
DB_PASSWORD=project_name

# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional: override the dev-only Keycloak client secret baked into
# keycloak/project-name-realm.json and backend/src/main/resources/application.yml.
# There is no real identity provider involved (see keycloak/README.md), so leaving this unset
# (falls back to "project-name-dev-secret") is fine locally.
# OIDC_CLIENT_SECRET=project-name-dev-secret
